# Caddyfile Voxa (прод). DOMAIN приходит из .env через docker-compose.
# Для DOMAIN=localhost Caddy сам выпустит self-signed сертификат —
# так можно проверить весь прод-стек локально без домена.

{$DOMAIN} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server

		# Чужой сайт не сможет открыть Voxa в невидимом фрейме и подсунуть
		# пользователю клик по кнопке внутри приложения
		X-Frame-Options DENY

		# Что странице разрешено загружать и куда обращаться. Скрипты только
		# свои (встроенных нет — тема выставляется файлом /theme.js), картинки
		# и медиа дополнительно с поддомена файлов, сокеты — к себе и LiveKit.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://files.{$DOMAIN}; media-src 'self' blob: https://files.{$DOMAIN}; font-src 'self' data:; connect-src 'self' wss://{$DOMAIN} wss://livekit.{$DOMAIN} https://files.{$DOMAIN}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"

		# Микрофон и камера нужны самому приложению, остальное запрещаем
		Permissions-Policy "microphone=(self), camera=(self), display-capture=(self), geolocation=(), payment=(), usb=()"

		# HSTS: на localhost держим 0, иначе браузер навсегда переведёт ВСЕ
		# порты localhost на https и сломает разработку. На реальном домене
		# поставь HSTS_MAX_AGE=31536000 в .env
		Strict-Transport-Security "max-age={$HSTS_MAX_AGE:0}"
	}

	handle /api/* {
		reverse_proxy server:3000
	}

	handle /socket.io/* {
		reverse_proxy server:3000
	}

	# Веб-клиент: собранная статика лежит в образе Caddy (infra/caddy/Dockerfile)
	handle {
		root * /srv

		# Хэшированные ассеты неизменяемы — кэшируем надолго
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# index.html не кэшируем: иначе после обновления клиент останется старым
		@html path / /index.html
		header @html Cache-Control "no-cache"

		# SPA: неизвестные пути отдаём index.html — маршрутизация на клиенте
		try_files {path} /index.html
		file_server
	}
}

# Сигналинг LiveKit (WSS) — через Caddy с автосертификатом;
# медиатрафик WebRTC идёт мимо прокси, напрямую по UDP
livekit.{$DOMAIN} {
	reverse_proxy livekit:7880
}

# Файлы (MinIO) — отдельный поддомен с песочницей (раздел 9 PRD):
# даже если вредоносный файл откроют инлайн, он изолирован от основного origin
files.{$DOMAIN} {
	header {
		Content-Security-Policy "sandbox; default-src 'none'"
		X-Content-Type-Options nosniff
		-Server
	}
	reverse_proxy minio:9000
}
