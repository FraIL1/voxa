# ==== Voxa: конфигурация прод-развёртывания (docker-compose.yml) ====
# 1. Скопируй файл:            cp .env.example .env
# 2. Сгенерируй каждый секрет: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# .env в git не попадает (см. .gitignore).

# Домен, на который Caddy автоматически получит TLS-сертификат (Let's Encrypt).
# Для локальной проверки прод-стека оставь localhost — Caddy выпустит self-signed.
DOMAIN=localhost

# Адрес приложения для ссылок-приглашений и кодов регистрации.
# По умолчанию https://<DOMAIN>; для локальной проверки без TLS раскомментируй:
# PUBLIC_URL=http://localhost

# HSTS: на реальном домене поставь 31536000 (год) — браузер будет ходить
# только по https. На localhost оставь 0, иначе сломается разработка.
HSTS_MAX_AGE=0

# PostgreSQL
POSTGRES_PASSWORD=CHANGE_ME

# Redis. Наружу порт не выведен, но пароль всё равно нужен: он защищает
# сессии и присутствие, если взломают какой-нибудь другой контейнер.
REDIS_PASSWORD=CHANGE_ME

# MinIO (S3-хранилище файлов)
MINIO_ROOT_USER=voxa
MINIO_ROOT_PASSWORD=CHANGE_ME

# JWT (этап 1) — два РАЗНЫХ случайных секрета
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME

# LiveKit (голос, этап 3): ключ и секрет (секрет — минимум 32 символа)
LIVEKIT_API_KEY=voxa
LIVEKIT_API_SECRET=CHANGE_ME_32_chars_minimum
# Адрес сигналинга для клиентов по умолчанию — wss://livekit.<DOMAIN>
# (нужна A-запись livekit.домен → VPS); переопределение — раскомментируй:
# PUBLIC_LIVEKIT_URL=wss://livekit.example.com
